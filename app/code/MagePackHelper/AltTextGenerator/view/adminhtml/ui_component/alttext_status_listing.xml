<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">alttext_status_listing.alttext_status_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>alttext_status_columns</spinner>
        <deps>
            <dep>alttext_status_listing.alttext_status_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="alttext_status_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>MagePackHelper_AltTextGenerator::status</aclResource>
        <dataProvider class="MagePackHelper\AltTextGenerator\Ui\Component\Listing\Status\DataProvider"
                      name="alttext_status_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <filters name="listing_filters">
            <filterSelect name="store_id" provider="${ $.parentName }">
                <settings>
                    <options class="Magento\Store\Ui\Component\Listing\Column\Store\Options"/>
                    <caption translate="true">All Store Views</caption>
                    <label translate="true">Store</label>
                    <dataScope>store_id</dataScope>
                    <imports>
                        <link name="visible">ns = ${ $.ns }, componentType = column, index = ${ $.index }:visible</link>
                    </imports>
                </settings>
            </filterSelect>
        </filters>
        <massaction name="listing_massaction" component="Magento_Ui/js/grid/tree-massactions">
            <action name="generate">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to generate missing alt text for the selected
                            items?
                        </message>
                        <title translate="true">Generate Alt Texts</title>
                    </confirm>
                    <url path="alttext/status/massGenerate"/>
                    <type>generate</type>
                    <label translate="true">Generate Alt Texts</label>
                </settings>
            </action>
            <action name="fix">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to generate missing alt text for the
                            selected items and save it to the database?
                        </message>
                        <title translate="true">Fix Alt Texts</title>
                    </confirm>
                    <url path="alttext/status/massFix"/>
                    <type>fix</type>
                    <label translate="true">Fix Alt Texts</label>
                </settings>
            </action>
        </massaction>
    </listingToolbar>
    <columns name="alttext_status_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>entity_id</indexField>
                <resizeEnabled>false</resizeEnabled>
                <resizeDefaultWidth>55</resizeDefaultWidth>
            </settings>
        </selectionsColumn>
        <column name="entity_id" sortOrder="10">
            <settings>
                <label translate="true">ID</label>
                <filter>textRange</filter>
                <draggable>false</draggable>
            </settings>
        </column>
        <column name="target_type" sortOrder="20">
            <settings>
                <label translate="true">Target Object Type</label>
                <filter>text</filter>
                <draggable>false</draggable>
            </settings>
        </column>
        <column name="target_id" sortOrder="30">
            <settings>
                <label translate="true">Target Object ID</label>
                <filter>textRange</filter>
                <draggable>false</draggable>
            </settings>
        </column>
        <column name="missing_alt_text_count" sortOrder="35">
            <settings>
                <label translate="true">Missing Alt Qty</label>
                <filter>textRange</filter>
                <sorting>desc</sorting>
                <draggable>false</draggable>
            </settings>
        </column>
        <column name="store_id" sortOrder="50" class="MagePack\Catalog\Ui\Component\Listing\Columns\Store">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <label translate="true">Store</label>
            </settings>
        </column>
        <column name="generated_alt_text_count" sortOrder="57">
            <settings>
                <label translate="true">Generated Alt Qty</label>
                <filter>text</filter>
                <draggable>false</draggable>
            </settings>
        </column>

        <column name="scan_info"
                class="MagePackHelper\AltTextGenerator\Ui\Component\Listing\Column\TextFieldRenderer"
                sortOrder="60">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <label translate="true">Scan Info</label>
            </settings>
        </column>

        <column name="generation_info"
                class="MagePackHelper\AltTextGenerator\Ui\Component\Listing\Column\TextFieldRenderer"
                sortOrder="70">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <label translate="true">Generation Info</label>
            </settings>
        </column>

<!--        <actionsColumn name="description" sortOrder="90"-->
<!--                       class="MagePackHelper\AltTextGenerator\Ui\Component\Listing\Column\DescriptionAction">-->
<!--            <argument name="data" xsi:type="array">-->
<!--                <item name="config" xsi:type="array">-->
<!--                    <item name="component" xsi:type="string">MagePackHelper_AltTextGenerator/js/grid/columns/description-action</item>-->
<!--                    <item name="indexField" xsi:type="string">entity_id</item>-->
<!--                    <item name="label" xsi:type="string">Description</item>-->
<!--                    <item name="urlEntityParamName" xsi:type="string">id</item>-->
<!--                    <item name="editDescriptionUrlPath" xsi:type="string">alttext/product/description</item>-->
<!--                </item>-->
<!--            </argument>-->
<!--            <settings>-->
<!--                <indexField>entity_id</indexField>-->
<!--            </settings>-->
<!--        </actionsColumn>-->
        <actionsColumn name="actions" sortOrder="95"
                       class="MagePackHelper\AltTextGenerator\Ui\Component\Listing\Status\ActionColumn">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="urlEntityParamName" xsi:type="string">id</item>
                    <item name="scanUrlPath" xsi:type="string">alttext/status/scan</item>
                    <item name="generateUrlPath" xsi:type="string">alttext/status/generate</item>
                    <item name="fixUrlPath" xsi:type="string">alttext/status/fix</item>
<!--                    <item name="editDescriptionUrlPath" xsi:type="string">alttext/product/description</item>-->
                    <item name="editUrlPath" xsi:type="string">alttext/status/edit</item>
                </item>
            </argument>
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
