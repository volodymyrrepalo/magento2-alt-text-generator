<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="alt_text" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>Alt Text Generator</label>
            <tab>mage_pack</tab>
            <resource>MagePackHelper_AltTextGenerator::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>General</label>
                <field id="enabled_cron_scan" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Run Alt Text Monitoring by Cron</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Runs a check for missing alt text without making changes.</comment>
                </field>
            </group>
            <group id="chat_gpt" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Chat GPT Settings</label>
                <field id="max_generations_per_day" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Daily Limit for Generated Alt Texts</label>
                    <validate>required-entry validate-not-negative-number</validate>
                </field>
                <field id="key" translate="label" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="instructions" translate="label" type="textarea" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Instructions for ChatGPT</label>
                </field>
            </group>
        </section>
    </system>
</config>
